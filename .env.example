# Copie para .env e preencha. O .env nunca deve ser commitado.

# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
JUDGE_MODEL=claude-sonnet-5-5

# --- Banco vetorial (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assistente_docs

# --- Embeddings locais (fastembed) ---
# Ao trocar de modelo, ajuste EMBEDDING_DIM e recrie a tabela `chunks`.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# --- Retrieval e chunking ---
RETRIEVAL_TOP_K=6
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# --- Ingestão ---
SOURCES_FILE=sources.yaml
RAW_CACHE_DIR=data/raw
CRAWL_DELAY_SECONDS=1.0
CRAWL_USER_AGENT=assistente-docs-rag/0.1

# --- Observabilidade (opcional): o tracing só liga com as duas chaves preenchidas ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
